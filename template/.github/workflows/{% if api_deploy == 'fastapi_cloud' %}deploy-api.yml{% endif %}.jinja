# Deploy the API to FastAPI Cloud after the CI passes on main (https://fastapicloud.com/docs).
#
# Needs two repository secrets: FASTAPI_CLOUD_TOKEN (a deploy token from the app's dashboard,
# Tokens → Create Token) and FASTAPI_CLOUD_APP_ID. `fastapi cloud setup-ci` creates both.
# Without them this workflow skips the deploy and says so.
name: Deploy API

on:
  # zizmor flags every workflow_run trigger; the job's `if` below is what makes this one safe.
  workflow_run: # zizmor: ignore[dangerous-triggers]
    workflows: [CI]
    types: [completed]
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: deploy-api
  cancel-in-progress: false

jobs:
  deploy:
    name: FastAPI Cloud
    # Only after a CI run of a push to main in this repository. The `branches` filter above alone
    # would also let through a pull request from a fork whose branch is called main, and this job
    # would deploy the fork's commit with the secrets.
    if: >-
      github.event_name == 'workflow_dispatch' || (github.event.workflow_run.conclusion == 'success'
      && github.event.workflow_run.event == 'push')
    runs-on: ubuntu-latest
    timeout-minutes: 20
    env:
      FASTAPI_CLOUD_TOKEN: ${{ '{{' }} secrets.FASTAPI_CLOUD_TOKEN {{ '}}' }}
      FASTAPI_CLOUD_APP_ID: ${{ '{{' }} secrets.FASTAPI_CLOUD_APP_ID {{ '}}' }}
      COMMIT: ${{ '{{' }} github.event.workflow_run.head_sha || github.sha {{ '}}' }}
    steps:
      - name: Secrets present?
        id: secrets
        run: |
          if [ -z "$FASTAPI_CLOUD_TOKEN" ] || [ -z "$FASTAPI_CLOUD_APP_ID" ]; then
            echo "::notice::FASTAPI_CLOUD_TOKEN or FASTAPI_CLOUD_APP_ID is not set: skipping the deploy (README, 'Deploy')."
            echo "ready=false" >> "$GITHUB_OUTPUT"
          else
            echo "ready=true" >> "$GITHUB_OUTPUT"
          fi
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        if: steps.secrets.outputs.ready == 'true'
        with:
          persist-credentials: false
          ref: ${{ '{{' }} env.COMMIT {{ '}}' }}
      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2 # v10.3.3
        if: steps.secrets.outputs.ready == 'true'
        with:
          python-version: "3.14"
      # FastAPI Cloud does not expose the deployed commit to the app: this file carries it
      # (observability.deployed_commit reads it). It is git-ignored, but `fastapi deploy`
      # uploads it because it is written here, in the uploaded folder.
      - name: Record the deployed commit
        if: steps.secrets.outputs.ready == 'true'
        working-directory: backend
        run: echo "$COMMIT" > DEPLOYED_COMMIT
      - name: fastapi deploy
        if: steps.secrets.outputs.ready == 'true'
        working-directory: backend
        run: uv run --locked fastapi deploy
