# Copy to backend/.env for local overrides. Nothing here is required: the defaults work locally.
# Variables of this project start with {{ env_prefix }}; DATABASE_URL and LOGFIRE_* are also read.

# {{ env_prefix }}ENVIRONMENT=local
{%- if with_database %}
# {{ env_prefix }}DATABASE_URL=postgresql://{{ package_name }}:{{ package_name }}@localhost:{{ postgres_port }}/{{ package_name }}
# {{ env_prefix }}MIGRATE_ON_START=false
{%- endif %}
{%- if with_frontend and api_deploy != 'vercel' %}

# Only requests through the visor's domain reach /api when this is set: the same random value here
# (on the API's platform) and as ORIGIN_SECRET in the Vercel project, for Production and Preview.
# {{ env_prefix }}ORIGIN_SECRET=
{%- endif %}
{%- if auth == 'sessions' %}

# The visor's origins, comma-separated. Only browsers from before 2023, which do not send
# Sec-Fetch-Site, need them to sign out or change anything with the session cookie:
# {{ env_prefix }}AUTH_PUBLIC_ORIGINS=https://{{ project_slug }}.vercel.app
{%- elif auth == 'oidc' %}

# Sign-in through an OIDC provider. Until the issuer is set, protected routes answer 503.
# {{ env_prefix }}AUTH_ISSUER=https://my-app.eu.auth0.com/
# {{ env_prefix }}AUTH_AUDIENCE=https://api.example.com
# {{ env_prefix }}AUTH_JWKS_URL=          (read from the issuer's discovery document when empty)
# {{ env_prefix }}AUTH_ALGORITHMS=RS256,ES256,EdDSA
# {{ env_prefix }}AUTH_AUTHORIZED_PARTIES=          (client ids accepted in `azp`, e.g. for Clerk)
# {{ env_prefix }}AUTH_EMAIL_CLAIM=email
{%- endif %}

{% if email == 'smtp' %}# Outgoing email. Without these, messages go to the local Mailpit (make db-up): http://localhost:8025.
# In production, your provider's SMTP server; check it with `uv run {{ project_slug }} send-test-email --to you@…`.
# {{ env_prefix }}SMTP_HOST=smtp.example.com
# {{ env_prefix }}SMTP_PORT=587
# {{ env_prefix }}SMTP_SECURITY=starttls
# {{ env_prefix }}SMTP_USERNAME=
# {{ env_prefix }}SMTP_PASSWORD=
# {{ env_prefix }}EMAIL_FROM=My App <no-reply@my-app.example>

{% endif %}# Logfire: without a token nothing is sent. To send local traces, run `uv run logfire auth` and
# `uv run logfire init use --name <project>` (Logfire 6; before it, `logfire projects use <project>`),
# or set a write token:
# LOGFIRE_TOKEN=

# Read token for `uv run {{ project_slug }} obs status` (better kept in ~/.config/{{ project_slug }}/logfire-read-token):
# LOGFIRE_READ_TOKEN=
