[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
requires-python = ">=3.14"
dependencies = [
{%- if with_database %}
    "asyncpg>=0.32.0",
{%- endif %}
{%- if api_deploy == 'fastapi_cloud' %}
    # FastAPI Cloud runs the app with the FastAPI CLI, and `fastapi deploy` comes with it.
    "fastapi[standard]>=0.162.5",
{%- else %}
    "fastapi>=0.162.5",
{%- endif %}
    "httpx>=0.28.1",
    "logfire[{% if with_database %}asyncpg,{% endif %}fastapi,httpx]>=5.6.0",
{%- if agent == 'pydantic_ai' %}
    # The agent (agent/): Pydantic AI with the Anthropic and OpenAI providers only (the full
    # `pydantic-ai` brings every provider, too heavy for serverless functions).
    "pydantic-ai-slim[anthropic,openai]>=2.68.0",
{%- endif %}
    "pydantic-settings>=2.16.2",
{%- if agent == 'pydantic_ai' %}
    # Loads the model provider's key from backend/.env into the environment (agent/model.py).
    "python-dotenv>=1.2.4",
{%- endif %}
{%- if auth == 'sessions' %}
    # Argon2id password hashing (auth/passwords.py).
    "pwdlib[argon2]>=0.4.0",
{%- elif auth == 'oidc' %}
    # Verification of the provider's signed tokens (auth/verify.py).
    "pyjwt[crypto]>=2.15.1",
{%- endif %}
    "typer>=0.29.1",
    "uvicorn[standard]>=0.54.0",
]

[project.scripts]
{{ project_slug }} = "{{ package_name }}.cli:app"

# Entry point for `fastapi dev`/`fastapi run` and for FastAPI Cloud.
[tool.fastapi]
entrypoint = "{{ package_name }}.api.main:app"

[build-system]
requires = ["uv_build>=0.11.19,<0.14.0"]
build-backend = "uv_build"

[dependency-groups]
dev = [
    "asgi-lifespan>=2.1.0",
{%- if type_checker == 'ty' %}
    "ty>=0.0.102",
{%- else %}
    "pyright>=1.1.414",
{%- endif %}
    "pytest>=9.2.0",
    "pytest-asyncio>=1.5.0",
    "pytest-cov>=7.1.0",
    "ruff>=0.17.5",
    # Security audit of the GitHub Actions workflows (make check).
    "zizmor>=1.32.0",
]

# Only releases that are at least 7 days old: a compromised release is usually found and withdrawn
# within days. Dependabot waits as long (.github/dependabot.yml). Needs uv 0.9.17 or newer. For an
# urgent fix, exempt one package: exclude-newer-package = { <name> = false }.
[tool.uv]
exclude-newer = "7 days"

# pytest 9's own table (typed values, not ini strings).
[tool.pytest]
# Unknown markers and configuration keys, an xfail that passes and duplicate parametrize ids are
# errors, not warnings.
strict = true
asyncio_mode = "auto"
asyncio_default_fixture_loop_scope = "function"
testpaths = ["tests"]
# Logfire's pytest plugin only activates with CI=true and a LOGFIRE_TOKEN; tests never send data.
addopts = ["--no-logfire"]
filterwarnings = ["error::DeprecationWarning:{{ package_name }}.*"]

# `make coverage`: branch coverage of the package, files with nothing left uncovered omitted.
[tool.coverage.run]
source = ["src"]
branch = true

[tool.coverage.report]
skip_empty = true

[tool.ruff]
line-length = 100
target-version = "py314"

[tool.ruff.lint]
# ASYNC: blocking calls inside async code. FAST: FastAPI rules. RUF: ruff's own rules.
# S: security, among them SQL built with string formatting (S608). PT: pytest style. DTZ: dates
# without a time zone. C4, PERF: comprehensions and loops. PTH: pathlib. T20: stray print().
select = [
    "E", "F", "I", "UP", "B", "SIM", "ASYNC", "FAST", "RUF",
    "S", "PT", "DTZ", "C4", "PERF", "PTH", "T20",
]
ignore = ["E501"]

[tool.ruff.lint.per-file-ignores]
{%- if auth == 'sessions' or email == 'smtp' %}
# Tests assert and sign in with made-up passwords.
"tests/*" = ["S101", "S105", "S106"]
{%- else %}
# Tests assert.
"tests/*" = ["S101"]
{%- endif %}
# Logfire's query API takes SQL as text, without parameters: obs.py only puts its own constants
# and a validated environment name into it.
"**/obs.py" = ["S608"]
{%- if type_checker == 'ty' %}

[tool.ty.environment]
python-version = "3.14"

[tool.ty.src]
include = ["src", "tests"]
{%- else %}

# Same level as Pylance in VS Code ("standard"): what passes here shows no warnings in the editor.
[tool.pyright]
pythonVersion = "3.14"
venvPath = "."
venv = ".venv"
typeCheckingMode = "standard"
include = ["src", "tests"]
{%- endif %}
