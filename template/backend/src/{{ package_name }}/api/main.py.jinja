"""The {{ project_name }} API. Every route lives under /api, so the visor and the API can share a domain."""

from collections.abc import AsyncGenerator
from contextlib import asynccontextmanager

import logfire
from fastapi import FastAPI

from .. import __version__
{%- if with_database %}
from ..db.migrate import migrate
from ..db.pool import Database, connect
{%- endif %}
from ..observability import configure_logfire, instrument_api
from ..settings import get_settings
from . import routes


@asynccontextmanager
async def lifespan(app: FastAPI) -> AsyncGenerator[None]:
{%- if with_database %}
    settings = get_settings()
    database: Database = app.state.database
    if settings.migrate_on_start:
        async with connect(settings.database_url) as conn:
            applied = await migrate(conn)
        logfire.info("migrations applied at start-up: {applied}", applied=applied)
    await database.pool()
{%- endif %}
    # One record per start: tells from when this version serves, even if nobody called it yet.
    logfire.info("api started")
{%- if with_database %}
    try:
        yield
    finally:
        await database.close()
{%- else %}
    yield
{%- endif %}


def create_app() -> FastAPI:
    settings = get_settings()
    configure_logfire(settings)
    app = FastAPI(
        title="{{ project_name }} API",
        version=__version__,
        description="{{ description }}",
        lifespan=lifespan,
    )
{%- if with_database %}
    app.state.database = Database(
        settings.database_url,
        min_size=settings.db_pool_min_size,
        max_size=settings.db_pool_max_size,
    )
{%- endif %}
    instrument_api(app)
    app.include_router(routes.router, prefix="/api")
    return app


app = create_app()
