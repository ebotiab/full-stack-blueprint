import asyncio
{% endif -%}
{% if with_frontend and api_deploy != 'vercel' -%}
import hmac
{% endif -%}
from collections.abc import AsyncGenerator
from contextlib import asynccontextmanager{% if jobs == 'postgres' %}, suppress{% endif %}

import logfire
from fastapi import FastAPI, Request, Response
{%- if with_frontend and api_deploy != 'vercel' %}
from fastapi.responses import JSONResponse
{%- endif %}
