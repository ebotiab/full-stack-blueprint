"""Settings read from the environment (and from backend/.env). Everything works locally without credentials."""

from functools import lru_cache
{%- if auth != 'none' %}
from typing import Annotated
{%- endif %}

from pydantic import AliasChoices, Field{% if auth != 'none' %}, field_validator{% endif %}
from pydantic_settings import BaseSettings, {% if auth != 'none' %}NoDecode, {% endif %}SettingsConfigDict

#: Prefix of this project's environment variables.
PREFIX = "{{ env_prefix }}"
{%- if with_database %}
{#- The URL is an f-string over a short constant so its line has the same length for every
    package name: written out in full, ruff format rewraps it for some name lengths. #}
#: User, password and database name of the docker-compose PostgreSQL (make db-up).
_LOCAL_DB = "{{ package_name }}"
#: The docker-compose PostgreSQL.
LOCAL_DATABASE_URL = f"postgresql://{_LOCAL_DB}:{_LOCAL_DB}@localhost:{{ postgres_port }}/{_LOCAL_DB}"
{%- endif %}


class Settings(BaseSettings):
    model_config = SettingsConfigDict(env_prefix=PREFIX, env_file=".env", extra="ignore")

    #: `local`, `preview` or `production`. Logfire groups traces by it.
    environment: str = Field(
        default="local",
        validation_alias=AliasChoices(f"{PREFIX}ENVIRONMENT", "LOGFIRE_ENVIRONMENT"),
    )
{%- if with_database %}
    #: In production the platform (or you) sets DATABASE_URL; locally it is the docker-compose container.
    database_url: str = Field(
        default=LOCAL_DATABASE_URL,
        validation_alias=AliasChoices(f"{PREFIX}DATABASE_URL", "DATABASE_URL"),
    )
{%- if api_deploy == 'vercel' %}
    #: Vercel runs the API as functions: each instance keeps a small pool, and the connection goes
    #: through Neon's pooler (the `-pooler` host), which does the real pooling.
    db_pool_min_size: int = 0
    db_pool_max_size: int = 4
{%- else %}
    db_pool_min_size: int = 1
    db_pool_max_size: int = 8
{%- endif %}
    #: Apply pending migrations when the API starts. On by default where the platform has no
    #: pre-deploy step ({% if api_deploy in ['render', 'fastapi_cloud'] %}this target{% else %}not this target: {{ 'Railway runs them as preDeploy' if api_deploy == 'railway' else 'the deploy workflow runs them before Vercel deploys' }}{% endif %}).
    migrate_on_start: bool = {{ 'True' if api_deploy in ['render', 'fastapi_cloud'] else 'False' }}
{%- endif %}
{%- if with_frontend and api_deploy != 'vercel' %}
    #: The value Vercel adds as `x-origin-secret` to every /api request it proxies
    #: (frontend/vercel.json, from the Vercel variable ORIGIN_SECRET). When set, the API refuses
    #: /api requests without it: only the visor's domain reaches the API. Empty: not checked.
    origin_secret: str = ""
{%- endif %}
{%- if auth == 'sessions' %}
    #: The visor's origins, comma-separated (`https://my-app.vercel.app`). Only browsers that do not
    #: send `Sec-Fetch-Site` (from before 2023) need them: see `auth/deps.py`, `check_same_origin`.
    auth_public_origins: Annotated[list[str], NoDecode] = Field(default_factory=list)

    @field_validator("auth_public_origins", mode="before")
    @classmethod
    def _split_origins(cls, value: object) -> object:
        if isinstance(value, str):
            return [origin.strip() for origin in value.split(",") if origin.strip()]
        return value
{%- elif auth == 'oidc' %}
    #: The provider's issuer, exactly as its tokens' `iss` says (e.g. `https://my-app.eu.auth0.com/`).
    #: While it is empty, protected routes answer 503: sign-in is not configured.
    auth_issuer: str = ""
    #: Where the provider publishes its signing keys. Empty: read from the issuer's OpenID
    #: discovery document (`<issuer>/.well-known/openid-configuration`).
    auth_jwks_url: str = ""
    #: The `aud` every token must carry (the API's identifier at the provider). Empty: not checked.
    auth_audience: str = ""
    #: Signature algorithms accepted, comma-separated. Asymmetric only: see `auth/verify.py`.
    auth_algorithms: Annotated[list[str], NoDecode] = Field(
        default_factory=lambda: ["RS256", "ES256", "EdDSA"]
    )
    #: Client ids accepted in `azp`, comma-separated, for providers whose tokens carry no `aud`
    #: (Clerk). Empty: not checked.
    auth_authorized_parties: Annotated[list[str], NoDecode] = Field(default_factory=list)
    #: The claim that holds the user's email (Auth0 namespaces custom claims: set its name here).
    auth_email_claim: str = "email"

    @field_validator("auth_algorithms", "auth_authorized_parties", mode="before")
    @classmethod
    def _split(cls, value: object) -> object:
        if isinstance(value, str):
            return [item.strip() for item in value.split(",") if item.strip()]
        return value

    @field_validator("auth_algorithms")
    @classmethod
    def _asymmetric_only(cls, value: list[str]) -> list[str]:
        # HS256 would make the provider's public key a shared secret: anyone could sign tokens.
        refused = [alg for alg in value if alg.upper().startswith("HS") or alg.lower() == "none"]
        if refused:
            raise ValueError(f"only asymmetric algorithms are accepted, not {refused}")
        return value
{%- endif %}


@lru_cache
def get_settings() -> Settings:
    return Settings()
