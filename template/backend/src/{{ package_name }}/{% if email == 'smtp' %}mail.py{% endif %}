"""Outgoing email through SMTP: Mailpit locally (`make db-up`), your provider in production.

A route takes a `MailerDep` and hands the message to a background task with `deliver`, so the
response neither waits for the SMTP server nor reveals, by its timing, whether a message was sent.
Tests override `get_mailer` with an object that keeps the messages instead.
"""

import asyncio
import smtplib
import ssl
from email.message import EmailMessage
from typing import Annotated, Protocol

import logfire
from fastapi import Depends

from .settings import Settings, get_settings


def message(to: str, subject: str, text: str) -> EmailMessage:
    """A plain-text message from the configured sender (`EMAIL_FROM`)."""
    msg = EmailMessage()
    msg["From"] = get_settings().email_from
    msg["To"] = to
    msg["Subject"] = subject
    msg.set_content(text)
    return msg


class Mailer(Protocol):
    async def send(self, message: EmailMessage) -> None: ...


class SmtpMailer:
    """Sends through the SMTP server of the settings (`SMTP_*`), in a thread: smtplib blocks."""

    def __init__(self, settings: Settings) -> None:
        self._settings = settings

    async def send(self, message: EmailMessage) -> None:
        await asyncio.to_thread(self._send, message)

    def _send(self, message: EmailMessage) -> None:
        settings = self._settings
        context = ssl.create_default_context()
        if settings.smtp_security == "tls":
            smtp = smtplib.SMTP_SSL(
                settings.smtp_host, settings.smtp_port, timeout=10, context=context
            )
        else:
            smtp = smtplib.SMTP(settings.smtp_host, settings.smtp_port, timeout=10)
        with smtp:
            if settings.smtp_security == "starttls":
                smtp.starttls(context=context)
            if settings.smtp_username:
                smtp.login(settings.smtp_username, settings.smtp_password)
            smtp.send_message(message)


def get_mailer() -> Mailer:
    return SmtpMailer(get_settings())


MailerDep = Annotated[Mailer, Depends(get_mailer)]


async def deliver(mailer: Mailer, message: EmailMessage) -> None:
    """Send, recording a failure instead of raising: for background tasks, after the response.

    The log keeps the subject, not the recipient or the body (they may hold a code).
    """
    try:
        await mailer.send(message)
    except OSError, smtplib.SMTPException:
        logfire.exception("could not send the email {subject!r}", subject=message["Subject"])
