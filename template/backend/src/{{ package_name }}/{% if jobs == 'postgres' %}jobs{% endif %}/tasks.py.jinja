"""The project's background tasks. Add a task to `TASKS`; if it is periodic, also to `SCHEDULE`.

A task receives a connection and the payload given to `queue.enqueue` (a dict that becomes JSON).
It may run more than once (delivery is at least once), so write it to be safe to repeat.
"""

import datetime as dt
from collections.abc import Awaitable, Callable
from typing import Any

import asyncpg

