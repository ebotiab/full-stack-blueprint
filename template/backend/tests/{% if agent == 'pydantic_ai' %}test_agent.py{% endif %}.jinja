async def test_agent_requires_sign_in(monkeypatch: pytest.MonkeyPatch) -> None:
    # Sign-in configured (an issuer), but no token.
    monkeypatch.setenv(f"{PREFIX}AUTH_ISSUER", "https://issuer.example")
    get_settings.cache_clear()
    get_verifier.cache_clear()
    try:
        response = await ask(agent_app(TestModel(), signed_in=False), "Who am I?")
    finally:
        get_settings.cache_clear()
        get_verifier.cache_clear()
    assert response.status_code == 401
