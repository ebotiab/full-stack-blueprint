def bearer(value: str) -> dict[str, str]:
    return {"Authorization": f"Bearer {value}"}


async def test_me_returns_the_caller_of_a_valid_token(http: httpx.AsyncClient) -> None:
    response = await http.get("/api/auth/me", headers=bearer(token()))
    assert response.status_code == 200
    body = response.json()
    assert (body["subject"], body["email"]) == ("user-1", "ada@example.com")
    assert response.headers["cache-control"] == "no-store"


async def test_me_needs_a_valid_token(http: httpx.AsyncClient) -> None:
    missing = await http.get("/api/auth/me")
    assert missing.status_code == 401
    assert missing.headers["www-authenticate"] == "Bearer"
    expired = await http.get("/api/auth/me", headers=bearer(token(exp=int(time.time()) - 120)))
    assert expired.status_code == 401
    assert expired.headers["www-authenticate"] == 'Bearer error="invalid_token"'


async def test_without_an_issuer_sign_in_is_not_configured(
    http: httpx.AsyncClient, verifier: Verifier
) -> None:
    verifier.issuer = ""
    response = await http.get("/api/auth/me", headers=bearer(token()))
    assert response.status_code == 503
    assert "AUTH_ISSUER" in response.json()["detail"]
{%- if with_database %}


async def test_a_user_row_is_kept_per_issuer_and_subject(
    http: httpx.AsyncClient, db_conn: asyncpg.Connection
) -> None:
    first = (await http.get("/api/auth/me", headers=bearer(token()))).json()
    renamed = token(email="ada@new.example")
    second = (await http.get("/api/auth/me", headers=bearer(renamed))).json()
    assert first["id"] == second["id"]
    rows = await db_conn.fetch("SELECT issuer, subject, email FROM users")
    assert [tuple(row) for row in rows] == [(ISSUER, "user-1", "ada@new.example")]
