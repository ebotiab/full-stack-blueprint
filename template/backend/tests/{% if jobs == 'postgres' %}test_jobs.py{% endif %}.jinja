@pytest.fixture
async def http(
    app_settings: None, monkeypatch: pytest.MonkeyPatch
) -> AsyncIterator[httpx.AsyncClient]:
    monkeypatch.setenv(f"{PREFIX}CRON_SECRET", "from-the-scheduler")
    get_settings.cache_clear()
    app = create_app()
    transport = httpx.ASGITransport(app=app)
    async with (
        LifespanManager(app),
        httpx.AsyncClient(transport=transport, base_url="https://test") as client,
    ):
        yield client


async def test_the_tick_needs_the_secret_and_runs_due_jobs(
    http: httpx.AsyncClient, conn: asyncpg.Connection, recorder: Recorder
) -> None:
    await queue.enqueue(conn, "record", {"n": 1})
    assert (await http.post("/api/jobs/tick")).status_code == 401
    wrong = {"Authorization": "Bearer guessed"}
    assert (await http.post("/api/jobs/tick", headers=wrong)).status_code == 401
    right = {"Authorization": "Bearer from-the-scheduler"}
    response = await http.get("/api/jobs/tick", headers=right)
    assert response.status_code == 200
    assert response.json()["ran"] >= 1
    assert recorder.payloads == [{"n": 1}]


