UTC = dt.UTC


class Recorder:
    """A task that records its payloads, and fails its first `failures` calls."""

    def __init__(self, failures: int = 0) -> None:
        self.payloads: list[dict[str, Any]] = []
        self.failures = failures

    async def __call__(self, conn: asyncpg.Connection, payload: dict[str, Any]) -> None:
        if self.failures:
            self.failures -= 1
            raise RuntimeError("not yet")
        self.payloads.append(payload)


@pytest.fixture
async def conn(db_conn: asyncpg.Connection) -> asyncpg.Connection:
    await migrate(db_conn)
    return db_conn


@pytest.fixture
def recorder(monkeypatch: pytest.MonkeyPatch) -> Recorder:
    task = Recorder()
    monkeypatch.setitem(TASKS, "record", task)
    return task


async def run(conn: asyncpg.Connection) -> int:
    return await queue.run_due(conn, seconds=10, schedule=[])


async def test_a_queued_job_runs_once_and_is_deleted(
    conn: asyncpg.Connection, recorder: Recorder
) -> None:
    await queue.enqueue(conn, "record", {"n": 1})
    assert await run(conn) == 1
    assert recorder.payloads == [{"n": 1}]
    assert await conn.fetchval("SELECT count(*) FROM jobs") == 0
    assert await run(conn) == 0


async def test_an_unknown_task_cannot_be_queued(conn: asyncpg.Connection) -> None:
    with pytest.raises(ValueError, match="no_such_task"):
        await queue.enqueue(conn, "no_such_task")


async def test_a_job_queued_in_a_rolled_back_transaction_never_runs(
    conn: asyncpg.Connection, recorder: Recorder
) -> None:
    async def change_that_fails() -> None:
        async with conn.transaction():
            await queue.enqueue(conn, "record", {"n": 1})
            raise RuntimeError("the change that needed the job failed")

    with pytest.raises(RuntimeError):
        await change_that_fails()
    assert await run(conn) == 0


async def test_a_delayed_job_waits(conn: asyncpg.Connection, recorder: Recorder) -> None:
    await queue.enqueue(conn, "record", delay=dt.timedelta(minutes=5))
    assert await run(conn) == 0


async def test_a_failure_is_retried_later_then_kept_as_failed(
    conn: asyncpg.Connection, monkeypatch: pytest.MonkeyPatch
) -> None:
    task = Recorder(failures=queue.MAX_ATTEMPTS)
    monkeypatch.setitem(TASKS, "record", task)
    job_id = await queue.enqueue(conn, "record")
    assert await run(conn) == 1
    row = await conn.fetchrow("SELECT * FROM jobs WHERE id = $1", job_id)
    assert row is not None
    assert row["attempts"] == 1
    assert row["failed_at"] is None
    assert row["last_error"] == "RuntimeError: not yet"
    # Against the database's clock: Docker's can drift from the host's (after a laptop sleeps).
    retry_later = "SELECT run_at > now() + interval '20 seconds' FROM jobs WHERE id = $1"
    assert await conn.fetchval(retry_later, job_id) is True
    assert await run(conn) == 0  # not due yet
    for _ in range(queue.MAX_ATTEMPTS - 1):
        await conn.execute("UPDATE jobs SET run_at = now()")
        assert await run(conn) == 1
    assert await conn.fetchval("SELECT failed_at IS NOT NULL FROM jobs") is True
    await conn.execute("UPDATE jobs SET run_at = now()")
    assert await run(conn) == 0  # failed jobs are not picked again
    assert task.payloads == []


async def test_a_job_whose_lease_ran_out_runs_again(
    conn: asyncpg.Connection, recorder: Recorder
) -> None:
    await queue.enqueue(conn, "record")
    await conn.execute("UPDATE jobs SET attempts = 1, locked_until = now() + interval '1 minute'")
    assert await run(conn) == 0  # another worker holds it
    await conn.execute("UPDATE jobs SET locked_until = now() - interval '1 second'")
    assert await run(conn) == 1  # that worker died
    assert len(recorder.payloads) == 1


@pytest.mark.parametrize("old_fails", [False, True], ids=["late-success", "late-failure"])
async def test_a_late_worker_leaves_the_new_lease_intact(
    conn: asyncpg.Connection, db_url: str, recorder: Recorder, old_fails: bool
) -> None:
    job_id = await queue.enqueue(conn, "record")
    first_started = asyncio.Event()
    reclaimed = asyncio.Event()
    lease_after_old_attempt: dt.datetime | None = None

    async def slow_task(conn: asyncpg.Connection, payload: dict[str, Any]) -> None:
        first_started.set()
        await reclaimed.wait()
        if old_fails:
            raise RuntimeError("late failure")

    async with connect(db_url) as other, asyncio.timeout(10), asyncio.TaskGroup() as workers:
        old_worker = workers.create_task(
            queue.run_due(conn, seconds=5, tasks={"record": slow_task}, schedule=[])
        )
        await first_started.wait()
        await other.execute("UPDATE jobs SET locked_until = now() - interval '1 second'")

        async def new_task(conn: asyncpg.Connection, payload: dict[str, Any]) -> None:
            nonlocal lease_after_old_attempt
            reclaimed.set()
            await old_worker
            lease_after_old_attempt = await conn.fetchval(
                "SELECT locked_until FROM jobs WHERE id = $1", job_id
            )

        assert await queue.run_due(other, seconds=5, tasks={"record": new_task}, schedule=[]) == 1

    assert lease_after_old_attempt is not None
    assert await conn.fetchval("SELECT count(*) FROM jobs") == 0


async def test_concurrent_workers_run_each_job_once(
    conn: asyncpg.Connection, db_url: str, recorder: Recorder
) -> None:
    for n in range(20):
        await queue.enqueue(conn, "record", {"n": n})

    async def worker() -> int:
        async with connect(db_url) as own:
            return await run(own)

    results = await asyncio.gather(worker(), worker(), worker())
    assert sum(results) == 20
    assert sorted(p["n"] for p in recorder.payloads) == list(range(20))


def test_slots() -> None:
    now = dt.datetime(2026, 11, 22, 10, 7, tzinfo=UTC)
    assert Every("t", minutes=15).slot(now) == dt.datetime(2026, 11, 22, 10, 0, tzinfo=UTC)
    assert Daily("t", at=dt.time(3, 0)).slot(now) == dt.datetime(2026, 11, 22, 3, 0, tzinfo=UTC)
    before = dt.datetime(2026, 11, 22, 2, 0, tzinfo=UTC)
    assert Daily("t", at=dt.time(3, 0)).slot(before) == dt.datetime(2026, 11, 21, 3, 0, tzinfo=UTC)


async def test_a_periodic_task_is_queued_once_per_slot(
    conn: asyncpg.Connection, db_url: str, recorder: Recorder
) -> None:
    schedule = [Every("record", minutes=15)]
    now = dt.datetime(2026, 11, 22, 10, 7, tzinfo=UTC)

    async def tick(at: dt.datetime) -> list[str]:
        async with connect(db_url) as own:
            return await queue.enqueue_scheduled(own, schedule, now=at)

    results = await asyncio.gather(tick(now), tick(now), tick(now))
    assert sorted(len(r) for r in results) == [0, 0, 1]
    assert await queue.enqueue_scheduled(conn, schedule, now=now + dt.timedelta(minutes=5)) == []
    later = now + dt.timedelta(minutes=10)
    assert await queue.enqueue_scheduled(conn, schedule, now=later) == ["record"]
    assert await conn.fetchval("SELECT count(*) FROM jobs") == 2


