async def test_run_soon_starts_a_queued_job_after_the_response(
    app_settings: None, conn: asyncpg.Connection, recorder: Recorder
) -> None:
    app = create_app()

    @app.post("/api/test/queue")
    async def queue_work(
        db: ConnectionDep, request: Request, background: BackgroundTasks
    ) -> dict[str, str]:
        await queue.enqueue(db, "record", {"n": 7})
        queue.run_soon(background, request)
        return {}

    transport = httpx.ASGITransport(app=app)
    async with (
        LifespanManager(app),
        httpx.AsyncClient(transport=transport, base_url="https://test") as client,
    ):
        assert (await client.post("/api/test/queue")).status_code == 200
    assert recorder.payloads == [{"n": 7}]


async def test_the_worker_loop_runs_jobs_until_cancelled(
    conn: asyncpg.Connection, db_url: str, recorder: Recorder
) -> None:
    from {{ package_name }}.db.pool import Database

    await queue.enqueue(conn, "record", {"n": 1})
    database = Database(db_url)
    worker = asyncio.create_task(queue.run_forever(database, poll_seconds=0.05))
    try:
        for _ in range(100):
            if recorder.payloads:
                break
            await asyncio.sleep(0.05)
    finally:
        worker.cancel()
        with pytest.raises(asyncio.CancelledError):
            await worker
        await database.close()
    assert recorder.payloads == [{"n": 1}]


def test_the_cli_lists_and_retries_failed_jobs(app_settings: None) -> None:
    runner = CliRunner()
    assert runner.invoke(cli, ["migrate"]).exit_code == 0

    async def add_failed_job() -> int:
        async with connect(get_settings().database_url) as own:
            job_id = await queue.enqueue(own, "prune_failed_jobs")
            await own.execute(
                "UPDATE jobs SET failed_at = now(), attempts = 5, last_error = 'Boom' WHERE id = $1",
                job_id,
            )
            return job_id

    job_id = asyncio.run(add_failed_job())
    listed = runner.invoke(cli, ["jobs", "failed"])
    assert "prune_failed_jobs" in listed.stdout
    assert "Boom" in listed.stdout
    assert runner.invoke(cli, ["jobs", "retry", "--id", str(job_id)]).exit_code == 0
    assert runner.invoke(cli, ["jobs", "retry", "--id", str(job_id)]).exit_code == 1
    ran = runner.invoke(cli, ["jobs", "run", "--seconds", "5"])
    assert ran.exit_code == 0, ran.output
