@pytest.mark.usefixtures("app_settings")
async def test_messages_come_from_the_database() -> None:
    app = create_app()
{%- if auth == 'sessions' %}
    # A stand-in for the signed-in user: tests/test_auth.py covers signing in.
    app.dependency_overrides[current_user] = lambda: User(id=1, email="a@b.example", is_admin=False)
{%- elif auth == 'oidc' %}
    # A stand-in for the signed-in user: tests/test_auth.py covers token verification.
    app.dependency_overrides[current_user] = lambda: User(id=1, subject="user-1", email=None)
{%- endif %}
    async with (
        LifespanManager(app),
        httpx.AsyncClient(transport=httpx.ASGITransport(app=app), base_url="http://test") as http,
    ):
        response = await http.get("/api/messages")
    assert response.status_code == 200
    assert [m["text"] for m in response.json()] == ["Hello from PostgreSQL"]
