# API image{% if api_deploy == 'render' %} for Render{% else %} for Railway{% endif %}. Built from backend/ (the service's root directory).
FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_NO_DEV=1 PYTHONUNBUFFERED=1

# Dependencies first, so code changes reuse this layer.
COPY pyproject.toml uv.lock README.md ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --locked --no-install-project

COPY src ./src
RUN --mount=type=cache,target=/root/.cache/uv uv sync --locked

ENV PATH="/app/.venv/bin:$PATH" PORT=8000
EXPOSE 8000
{%- if with_database %}
{%- if api_deploy == 'render' %}
# Pending migrations run when the API starts ({{ env_prefix }}MIGRATE_ON_START, on by default for
# this target): Render's free plan has no pre-deploy command.
{%- else %}
# Migrations run before each deploy as Railway's pre-deploy command (.railway/railway.ts).
{%- endif %}
{%- endif %}
# uvicorn directly: the image only has production dependencies, not the `fastapi` CLI.
CMD ["sh", "-c", "exec uvicorn {{ package_name }}.api.main:app --host 0.0.0.0 --port ${PORT} --proxy-headers --forwarded-allow-ips='*'"]
