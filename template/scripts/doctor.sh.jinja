#!/usr/bin/env bash
# Check the tools this project needs, and say how to fix whatever is missing. `make doctor`.
set -uo pipefail

problems=0
ok() { printf '  ok    %s\n' "$1"; }
bad() { printf '  FAIL  %s\n        fix: %s\n' "$1" "$2"; problems=$((problems + 1)); }

# version_at_least <found> <wanted>: true if found >= wanted (dotted numbers).
version_at_least() { [ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -n1)" = "$2" ]; }

printf 'Checking tools for %s\n' {{ project_name | quote }}

if command -v git >/dev/null 2>&1; then ok "git $(git --version | awk '{print $3}')"
else bad "git is not installed" "install it from https://git-scm.com/downloads"; fi

if command -v uv >/dev/null 2>&1; then
  uv_version=$(uv --version | awk '{print $2}')
  # 0.9.17 reads the relative `exclude-newer = "7 days"` of backend/pyproject.toml.
  if version_at_least "$uv_version" "0.9.17"; then ok "uv $uv_version (installs the project's Python by itself when needed)"
  else bad "uv $uv_version is too old (0.9.17 or newer is needed)" "uv self update  (or: brew upgrade uv)"; fi
else
  bad "uv is not installed" "curl -LsSf https://astral.sh/uv/install.sh | sh  (or: brew install uv)"
fi
{%- if with_frontend %}

if command -v node >/dev/null 2>&1; then
  node_version=$(node --version | sed 's/^v//')
  if version_at_least "$node_version" "22.12.0"; then ok "node $node_version"
  else bad "node $node_version is too old (22.12 or newer is needed)" "install Node 26 LTS: https://nodejs.org (or: nvm install 26 / brew install node@26)"; fi
else
  bad "node is not installed" "install Node 26 LTS: https://nodejs.org (or: nvm install 26 / brew install node@26)"
fi
if command -v npm >/dev/null 2>&1; then
  npm_version=$(npm --version)
  # 11.10 applies `min-release-age` (frontend/.npmrc); older versions ignore it with a warning.
  if version_at_least "$npm_version" "11.10.0"; then ok "npm $npm_version"
  else bad "npm $npm_version is too old (11.10 or newer applies the 7-day wait in frontend/.npmrc)" "npm install -g npm@11  (or install Node 26 LTS: https://nodejs.org)"; fi
else
  bad "npm is not installed" "it comes with Node: reinstall Node 26 LTS from https://nodejs.org"
fi
{%- endif %}
{%- if with_database %}

if command -v docker >/dev/null 2>&1; then
  if docker info >/dev/null 2>&1; then
    ok "docker $(docker version --format '{{ '{{' }}.Server.Version{{ '}}' }}' 2>/dev/null) (daemon running)"
    if docker compose version >/dev/null 2>&1; then ok "docker compose $(docker compose version --short)"
    else bad "docker compose is missing" "update Docker Desktop, or install the compose plugin: https://docs.docker.com/compose/install/"; fi
    # The local PostgreSQL port must be free, or already ours.
    owner=$(docker ps --filter "publish={{ postgres_port }}" --format '{{ '{{' }}.Names{{ '}}' }}' | head -n1)
    if [ -n "$owner" ] && [ "$owner" != "{{ project_slug }}-postgres" ]; then
      bad "port {{ postgres_port }} is used by the container $owner" "stop it, or move this project to a free port (commit your work first): copier update --defaults --data postgres_port=<port>"
    elif [ -z "$owner" ] && (exec 3<>/dev/tcp/127.0.0.1/{{ postgres_port }}) 2>/dev/null; then
      bad "port {{ postgres_port }} is used by another program" "stop it, or move this project to a free port (commit your work first): copier update --defaults --data postgres_port=<port>"
    else
      ok "port {{ postgres_port }} is available for PostgreSQL"
    fi
    # Every checkout shares one Compose project, {{ project_slug }} (docker-compose.yml, `name:`;
    # COMPOSE_PROJECT_NAME overrides it). A container of the same name under another Compose
    # project is in the way: this project's own from before `name:` (named after the folder), or
    # another project's with the same name. Removing it keeps its data, in its volume, which its
    # Compose project uses again when it next starts.
    expected=${COMPOSE_PROJECT_NAME:-{{ project_slug }}}
    for container in {{ project_slug }}-postgres{% if email == 'smtp' %} {{ project_slug }}-mailpit{% endif %}; do
      project=$(docker inspect --format '{{ '{{' }}index .Config.Labels "com.docker.compose.project"{{ '}}' }}' "$container" 2>/dev/null || true)
      if [ -n "$project" ] && [ "$project" != "$expected" ]; then
        bad "the container $container belongs to the Compose project $project, not $expected" "docker rm -f $container  (data lives in volumes, not containers: PostgreSQL's stays in ${project}_postgres18; make setup then starts this project's own and migrates it)"
      fi
    done
{%- if email == 'smtp' %}
    # Mailpit's ports (SMTP and its web page), also free or already ours.
    for port in 1025 8025; do
      owner=$(docker ps --filter "publish=$port" --format '{{ '{{' }}.Names{{ '}}' }}' | head -n1)
      if [ -n "$owner" ] && [ "$owner" != "{{ project_slug }}-mailpit" ]; then
        bad "port $port is used by the container $owner" "stop it (another project's Mailpit?): docker stop $owner"
      elif [ -z "$owner" ] && (exec 3<>/dev/tcp/127.0.0.1/$port) 2>/dev/null; then
        bad "port $port is used by another program" "stop it: Mailpit needs ports 1025 and 8025"
      else
        ok "port $port is available for Mailpit"
      fi
    done
{%- endif %}
  else
    bad "docker is installed but its daemon is not running" "start Docker Desktop (or: sudo systemctl start docker)"
  fi
else
  bad "docker is not installed (needed for the local PostgreSQL)" "install Docker Desktop: https://docs.docker.com/get-docker/"
fi
{%- endif %}

if [ "$problems" -gt 0 ]; then
  printf '\n%d problem(s) found. Fix them and run `make doctor` again.\n' "$problems"
  exit 1
fi
printf '\nAll tools are ready. Next: `make setup`.\n'
