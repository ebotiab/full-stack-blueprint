# Local PostgreSQL{% if email == 'smtp' %} and Mailpit{% endif %} for development and tests: `make db-up` (or `docker compose up -d --wait`).
# Production uses Neon{% if api_deploy == 'railway' %} or Railway's PostgreSQL{% endif %} (README, "Deploy").
services:
  postgres:
    image: postgres:18-alpine
    container_name: {{ project_slug }}-postgres
    environment:
      POSTGRES_USER: {{ package_name }}
      POSTGRES_PASSWORD: {{ package_name }}
      POSTGRES_DB: {{ package_name }}
    # Published on 127.0.0.1 only: the password is the project's name, so nothing outside this
    # machine should reach the database.
    ports:
      - "127.0.0.1:{{ postgres_port }}:5432"
    # From PostgreSQL 18 on, the volume goes on /var/lib/postgresql (the data is in 18/docker inside
    # it). One volume per major version: PostgreSQL does not start on another major's data, so a new
    # major starts empty and `make setup` migrates it. `docker volume ls` lists the old ones.
    volumes:
      - postgres18:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ package_name }} -d {{ package_name }}"]
      interval: 2s
      timeout: 3s
      retries: 30
{%- if email == 'smtp' %}

  # Local email: the API sends through SMTP on port 1025 and every message shows up at
  # http://localhost:8025. Nothing leaves the machine.
  mailpit:
    image: axllent/mailpit:v1.33
    container_name: {{ project_slug }}-mailpit
    ports:
      - "127.0.0.1:1025:1025"
      - "127.0.0.1:8025:8025"
    healthcheck:
      test: ["CMD", "/mailpit", "readyz"]
      interval: 2s
      timeout: 3s
      retries: 30
{%- endif %}

volumes:
  postgres18:
