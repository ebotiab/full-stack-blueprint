# Copy to frontend/.env.local for local overrides. Nothing here is required.

# Logfire for the browser: the two values Logfire generates for a frontend application, its
# restricted token and the URL of the project's region (logfire-eu or logfire-us). Both are needed.
# Only production builds on Vercel send errors; set them in the Vercel project, not here, unless
# you test telemetry locally.
# VITE_LOGFIRE_TOKEN=
# VITE_LOGFIRE_BASE_URL=https://logfire-eu.pydantic.dev
{%- if auth == 'oidc' %}

# Sign-in through the OIDC provider (src/RequireSignIn.tsx): its issuer URL and the client id of
# the visor's application there (a single-page app, code flow with PKCE, no secret). The audience
# is only for providers that need one to issue a JWT access token (Auth0: the API's identifier).
# Register http://127.0.0.1:5173 and the deployed URLs as redirect and logout URLs at the provider.
# VITE_OIDC_AUTHORITY=https://my-app.eu.auth0.com
# VITE_OIDC_CLIENT_ID=
# VITE_OIDC_AUDIENCE=
{%- endif %}
