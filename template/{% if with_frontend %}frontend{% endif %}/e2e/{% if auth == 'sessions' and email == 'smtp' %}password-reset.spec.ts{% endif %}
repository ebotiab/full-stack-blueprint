import { expect, test } from '@playwright/test'

// The test answers /api itself: it checks the two forms and what they send. The reset rules
// (one-time codes, expiry, attempts) are pytest's job, in backend/tests/test_auth.py.
test('resets the password with an emailed code, then asks to sign in', async ({ page }) => {
  await page.route('**/api/auth/me', (route) =>
    route.fulfill({ status: 401, json: { detail: 'Not signed in.' } }),
  )
  const sent: unknown[] = []
  await page.route('**/api/auth/password-reset', (route) => {
    sent.push(route.request().postDataJSON())
    return route.fulfill({ status: 204 })
  })
  await page.route('**/api/auth/password-reset/confirm', (route) => {
    sent.push(route.request().postDataJSON())
    return route.fulfill({ status: 204 })
  })
  await page.goto('/')
  await page.getByRole('button', { name: 'Forgot your password?' }).click()
  await page.getByLabel('Email').fill('ada@example.com')
  await page.getByRole('button', { name: 'Email me a code' }).click()
  await page.getByLabel('Code', { exact: true }).fill('ABCD-EFGH')
  await page.getByLabel('New password', { exact: true }).fill('a brand new password')
  await page.getByRole('button', { name: 'Set the new password' }).click()
  await expect(page.getByRole('form', { name: 'Sign in' })).toBeVisible()
  await expect(page.getByText('Password changed')).toBeVisible()
  expect(sent).toEqual([
    { email: 'ada@example.com' },
    { email: 'ada@example.com', code: 'ABCD-EFGH', new_password: 'a brand new password' },
  ])
})

test('says so when the code is wrong', async ({ page }) => {
  await page.route('**/api/auth/me', (route) =>
    route.fulfill({ status: 401, json: { detail: 'Not signed in.' } }),
  )
  await page.route('**/api/auth/password-reset', (route) => route.fulfill({ status: 204 }))
  await page.route('**/api/auth/password-reset/confirm', (route) =>
    route.fulfill({ status: 400, json: { detail: 'Wrong or expired code.' } }),
  )
  await page.goto('/')
  await page.getByRole('button', { name: 'Forgot your password?' }).click()
  await page.getByLabel('Email').fill('ada@example.com')
  await page.getByRole('button', { name: 'Email me a code' }).click()
  await page.getByLabel('Code', { exact: true }).fill('AAAA-AAAA')
  await page.getByLabel('New password', { exact: true }).fill('a brand new password')
  await page.getByRole('button', { name: 'Set the new password' }).click()
  await expect(page.getByRole('alert')).toHaveText('Wrong or expired code.')
})
