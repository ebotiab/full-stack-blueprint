{
  "name": "{{ project_slug }}-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "types": "npx --yes openapi-typescript@7.13.0 ../backend/openapi.json --output src/api/schema.d.ts",
    "types:print": "npx --yes openapi-typescript@7.13.0 ../backend/openapi.json"
  },
  "dependencies": {
    "@pydantic/logfire-browser": "^0.35.1",
    "@vercel/analytics": "^2.0.1",
{%- if auth == 'oidc' %}
    "oidc-client-ts": "^3.5.0",
{%- endif %}
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"{% if auth == 'oidc' %},
    "react-oidc-context": "^3.3.1"{% endif %}
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
{%- if ui == 'tailwind' %}
    "@tailwindcss/vite": "^4.3.5",
{%- endif %}
    "@types/node": "^26.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxfmt": "0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "~7.0.2006",
{%- if ui == 'tailwind' %}
    "tailwindcss": "^4.3.5",
{%- endif %}
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
