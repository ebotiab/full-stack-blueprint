// The visor's sign-in through the OIDC provider: authorization code flow with PKCE (oidc-client-ts,
// react-oidc-context). Until someone is signed in it shows a button that goes to the provider;
// afterwards every /api request carries the provider's access token (`Authorization: Bearer`).
// Settings: VITE_OIDC_AUTHORITY, VITE_OIDC_CLIENT_ID and, for some providers, VITE_OIDC_AUDIENCE
// (frontend/.env.example).
import { UserManager, WebStorageStateStore } from 'oidc-client-ts'
import type { ReactNode } from 'react'
import { AuthProvider, useAuth } from 'react-oidc-context'

import { api } from './api/client'

const authority = import.meta.env.VITE_OIDC_AUTHORITY as string | undefined
const clientId = import.meta.env.VITE_OIDC_CLIENT_ID as string | undefined
const audience = import.meta.env.VITE_OIDC_AUDIENCE as string | undefined

// The tokens live in sessionStorage, oidc-client-ts's default, and are gone when the tab closes.
// Any script on the page can read them: RFC 10017 ranks this below a session cookie, which is what
// `auth: sessions` uses.
const userManager =
  authority && clientId
    ? new UserManager({
        authority,
        client_id: clientId,
        redirect_uri: window.location.origin,
        post_logout_redirect_uri: window.location.origin,
        scope: 'openid profile email',
        extraQueryParams: audience ? { audience } : {},
        userStore: new WebStorageStateStore({ store: window.sessionStorage }),
      })
    : null

// Every request of the typed client gets the current access token, read when the request starts.
api.use({
  async onRequest({ request }) {
    const user = await userManager?.getUser()
    if (user && !user.expired) request.headers.set('Authorization', `Bearer ${user.access_token}`)
    return request
  },
})

// After the provider sends the browser back, drop `?code=…&state=…` from the address bar.
function removeAuthParams() {
  window.history.replaceState({}, document.title, window.location.pathname)
}

export function RequireSignIn({ children }: { children: ReactNode }) {
  if (!userManager) {
    return (
      <main>
        <h1>{document.title}</h1>
        <p role="alert">
          Sign-in is not configured: set VITE_OIDC_AUTHORITY and VITE_OIDC_CLIENT_ID.
        </p>
      </main>
    )
  }
  return (
    <AuthProvider userManager={userManager} onSigninCallback={removeAuthParams}>
      <Gate>{children}</Gate>
    </AuthProvider>
  )
}

function Gate({ children }: { children: ReactNode }) {
  const auth = useAuth()

  function signOut() {
    // Ends the session at the provider too; a provider without a logout endpoint only forgets
    // the tokens here.
    auth.signoutRedirect().catch(() => auth.removeUser())
  }

  if (auth.isAuthenticated && auth.user) {
    return (
      <>
        <header>
          Signed in as {auth.user.profile.email ?? auth.user.profile.sub}
          <button type="button" onClick={signOut}>
            Sign out
          </button>
        </header>
        {children}
      </>
    )
  }
  return (
    <main>
      <h1>{document.title}</h1>
      {auth.isLoading && <p>Loading…</p>}
      {auth.error && <p role="alert">Signing in failed: {auth.error.message}</p>}
      {!auth.isLoading && (
        <button type="button" onClick={() => void auth.signinRedirect()}>
          Sign in
        </button>
      )}
    </main>
  )
}
