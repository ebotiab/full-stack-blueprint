// The visor's sign-in gate. It asks /api/auth/me who is signed in and shows the form until someone
// is. The session is an HttpOnly cookie that the browser sends with every /api request by itself:
// no token ever reaches this code, so a script injected into the page cannot steal it.
import { useEffect, useState, type FormEvent, type ReactNode } from 'react'

import { api } from './api/client'
import type { components } from './api/schema'
{%- if email == 'smtp' %}
import { PasswordReset } from './PasswordReset'
{%- endif %}

type User = components['schemas']['User']

type State =
  | { status: 'loading' }
  | { status: 'error' }
{%- if email == 'smtp' %}
  | { status: 'signed-out'; notice?: string }
  | { status: 'resetting' }
{%- else %}
  | { status: 'signed-out' }
{%- endif %}
  | { status: 'signed-in'; user: User }

const UNAVAILABLE = 'The API is not responding. Try again later.'
{%- if email == 'smtp' %}
const CHANGED = 'Password changed: sign in with the new one.'
{%- endif %}

export function RequireSignIn({ children }: { children: ReactNode }) {
  const [state, setState] = useState<State>({ status: 'loading' })

  useEffect(() => {
    let active = true
    api
      .GET('/api/auth/me')
      .then(({ data, response }) => {
        if (!active) return
        if (data) setState({ status: 'signed-in', user: data })
        else setState(response.status === 401 ? { status: 'signed-out' } : { status: 'error' })
      })
      .catch(() => {
        if (active) setState({ status: 'error' })
      })
    return () => {
      active = false
    }
  }, [])

  function signOut() {
    api
      .POST('/api/auth/logout')
      .then(() => setState({ status: 'signed-out' }))
      .catch(() => setState({ status: 'signed-out' }))
  }

  if (state.status === 'signed-in') {
    return (
      <>
        <header>
          Signed in as {state.user.email}
          <button type="button" onClick={signOut}>
            Sign out
          </button>
        </header>
        {children}
      </>
    )
  }
  return (
    <main>
      <h1>{document.title}</h1>
      {state.status === 'loading' && <p>Loading…</p>}
      {state.status === 'error' && <p role="alert">{UNAVAILABLE}</p>}
{%- if email == 'smtp' %}
      {state.status === 'signed-out' && (
        <SignInForm
          notice={state.notice}
          onSignedIn={(user) => setState({ status: 'signed-in', user })}
          onForgot={() => setState({ status: 'resetting' })}
        />
      )}
      {state.status === 'resetting' && (
        <PasswordReset
          onDone={() => setState({ status: 'signed-out', notice: CHANGED })}
          onCancel={() => setState({ status: 'signed-out' })}
        />
      )}
{%- else %}
      {state.status === 'signed-out' && (
        <SignInForm onSignedIn={(user) => setState({ status: 'signed-in', user })} />
      )}
{%- endif %}
    </main>
  )
}

// What the form says for each refusal of POST /api/auth/login.
const PROBLEMS: Record<number, string> = {
  401: 'Wrong email or password.',
  429: 'Too many attempts. Try again in a minute.',
}

{% if email == 'smtp' -%}
type SignInProps = { onSignedIn: (user: User) => void; onForgot: () => void; notice?: string }

function SignInForm({ onSignedIn, onForgot, notice }: SignInProps) {
{%- else -%}
function SignInForm({ onSignedIn }: { onSignedIn: (user: User) => void }) {
{%- endif %}
  const [email, setEmail] = useState('')
  const [password, setPassword] = useState('')
  const [problem, setProblem] = useState<string | null>(null)
  const [busy, setBusy] = useState(false)

  function submit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault()
    setBusy(true)
    api
      .POST('/api/auth/login', { body: { email, password } })
      .then(({ data, response }) => {
        setBusy(false)
        if (data) onSignedIn(data)
        else setProblem(PROBLEMS[response.status] ?? UNAVAILABLE)
      })
      .catch(() => {
        setBusy(false)
        setProblem(UNAVAILABLE)
      })
  }

  return (
    <form aria-label="Sign in" onSubmit={submit}>
{%- if email == 'smtp' %}
      {notice && <output>{notice}</output>}
{%- endif %}
      <label>
        Email
        <input
          type="email"
          autoComplete="username"
          required
          value={email}
          onChange={(event) => setEmail(event.target.value)}
        />
      </label>
      <label>
        Password
        <input
          type="password"
          autoComplete="current-password"
          required
          value={password}
          onChange={(event) => setPassword(event.target.value)}
        />
      </label>
      {problem && <p role="alert">{problem}</p>}
      <button type="submit" disabled={busy}>
        Sign in
      </button>
{%- if email == 'smtp' %}
      <button type="button" onClick={onForgot}>
        Forgot your password?
      </button>
{%- endif %}
    </form>
  )
}
