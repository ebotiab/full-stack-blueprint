// Password reset by email (auth: sessions, email: smtp): first an emailed one-time code, then a new
// password with it. The API answers the same whether or not the email has an account, so the page
// never says whether one exists.
import { useState, type FormEvent } from 'react'

import { api } from './api/client'

const UNAVAILABLE = 'The API is not responding. Try again later.'

// What the form says for each refusal of POST /api/auth/password-reset/confirm.
const CONFIRM_PROBLEMS: Record<number, string> = {
  400: 'Wrong or expired code.',
  422: 'The new password needs 8 to 128 characters.',
  429: 'Too many attempts. Try again in a minute.',
}

export function PasswordReset({ onDone, onCancel }: { onDone: () => void; onCancel: () => void }) {
  const [email, setEmail] = useState('')
  const [sent, setSent] = useState(false)
  const [code, setCode] = useState('')
  const [password, setPassword] = useState('')
  const [problem, setProblem] = useState<string | null>(null)
  const [busy, setBusy] = useState(false)

  function requestCode(event: FormEvent<HTMLFormElement>) {
    event.preventDefault()
    setBusy(true)
    setProblem(null)
    api
      .POST('/api/auth/password-reset', { body: { email } })
      .then(({ response }) => {
        setBusy(false)
        if (response.ok) setSent(true)
        else setProblem(response.status === 429 ? 'Too many emails. Try again later.' : UNAVAILABLE)
      })
      .catch(() => {
        setBusy(false)
        setProblem(UNAVAILABLE)
      })
  }

  function setNewPassword(event: FormEvent<HTMLFormElement>) {
    event.preventDefault()
    setBusy(true)
    setProblem(null)
    api
      .POST('/api/auth/password-reset/confirm', { body: { email, code, new_password: password } })
      .then(({ response }) => {
        setBusy(false)
        if (response.ok) onDone()
        else setProblem(CONFIRM_PROBLEMS[response.status] ?? UNAVAILABLE)
      })
      .catch(() => {
        setBusy(false)
        setProblem(UNAVAILABLE)
      })
  }

  if (!sent) {
    return (
      <form aria-label="Reset password" onSubmit={requestCode}>
        <label>
          Email
          <input
            type="email"
            autoComplete="username"
            required
            value={email}
            onChange={(event) => setEmail(event.target.value)}
          />
        </label>
        {problem && <p role="alert">{problem}</p>}
        <button type="submit" disabled={busy}>
          Email me a code
        </button>
        <button type="button" onClick={onCancel}>
          Back to sign in
        </button>
      </form>
    )
  }
  return (
    <form aria-label="Set a new password" onSubmit={setNewPassword}>
      <p>If {email} has an account, a code is on its way. It works once, for one hour.</p>
      <label>
        Code
        <input
          autoComplete="one-time-code"
          required
          value={code}
          onChange={(event) => setCode(event.target.value)}
        />
      </label>
      <label>
        New password
        <input
          type="password"
          autoComplete="new-password"
          minLength={8}
          required
          value={password}
          onChange={(event) => setPassword(event.target.value)}
        />
      </label>
      {problem && <p role="alert">{problem}</p>}
      <button type="submit" disabled={busy}>
        Set the new password
      </button>
    </form>
  )
}
